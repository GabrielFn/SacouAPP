<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <!-- Only for `dotnet ef migrations add`: never flows to the API or its output. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../Sacou.Shared/Sacou.Shared.csproj" />
        <ProjectReference Include="../../Sacou.Http/Sacou.Http.csproj" />
        <!-- Only Identity.Contracts and Groups.Contracts are used: Sacou.Architecture.Tests checks it. -->
        <ProjectReference Include="../Identity/Sacou.Modules.Identity.csproj" />
        <ProjectReference Include="../Groups/Sacou.Modules.Groups.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Sacou.Modules.Notifications.Tests" />
        <!-- Only to swap the internal push port (it carries the token) for a fake: ADR 0069, D5; allowed by name in Sacou.Architecture.Tests. -->
        <InternalsVisibleTo Include="Sacou.Integration.Tests" />
    </ItemGroup>
</Project>
