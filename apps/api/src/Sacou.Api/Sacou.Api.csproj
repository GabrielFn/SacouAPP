<Project Sdk="Microsoft.NET.Sdk.Web">
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.OpenApi" />
    </ItemGroup>
    <ItemGroup>
        <!-- The OpenAPI transformers are internal; their tests read them (ADR 0042). -->
        <InternalsVisibleTo Include="Sacou.Api.Tests" />
    </ItemGroup>
    <ItemGroup>
        <!-- The terms of use and the privacy policy (E6.1, ADR 0083): one source of truth, published at /termos and /privacidade. -->
        <EmbeddedResource Include="../../../../docs/legal/*.md" LogicalName="Sacou.Api.Legal.%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Sacou.Modules/Identity/Sacou.Modules.Identity.csproj" />
        <ProjectReference Include="../Sacou.Modules/Groups/Sacou.Modules.Groups.csproj" />
        <ProjectReference Include="../Sacou.Modules/Sessions/Sacou.Modules.Sessions.csproj" />
        <ProjectReference Include="../Sacou.Modules/Matches/Sacou.Modules.Matches.csproj" />
        <ProjectReference Include="../Sacou.Modules/Notifications/Sacou.Modules.Notifications.csproj" />
        <ProjectReference Include="../Sacou.Modules/Payments/Sacou.Modules.Payments.csproj" />
        <ProjectReference Include="../Sacou.Modules/Summaries/Sacou.Modules.Summaries.csproj" />
        <ProjectReference Include="../Sacou.Modules/Stats/Sacou.Modules.Stats.csproj" />
    </ItemGroup>
</Project>
