@model RoundModel
@* The WhatsApp preview (ADR 0070, D5): the group's name, the date, the place and the count (no count 7 days after the start, E6.7). Never a nickname, even
   though the page shows the first names (question 126 keeps the preview without them). Razor encodes every value. *@
@if (Model.Round is { } round)
{
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:site_name" content="@WebTexts.Brand">
    <meta property="og:title" content="@round.GroupName">
    <meta property="og:description" content="@round.PreviewDescription">
    <meta property="og:url" content="@Model.PageUrl">
    <meta property="og:image" content="@Model.PreviewImageUrl">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="description" content="@round.PreviewDescription">
}
