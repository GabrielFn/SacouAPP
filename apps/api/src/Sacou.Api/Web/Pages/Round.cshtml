@page "/r/{code}"
@model RoundModel
@{
    Layout = null;
    var round = Model.Round;
    var firebase = round is { IsOpen: true } ? Model.Firebase : null;
}
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <title>@(round?.GroupName ?? WebTexts.LinkInvalidTitle)</title>
    @await Html.PartialAsync("Shared/_OpenGraph", Model)
    @if (Model.Assets is { } assets)
    {
        @foreach (var style in assets.Styles)
        {
            <link rel="stylesheet" href="@style">
        }
        <script type="module" src="@assets.Script"></script>
    }
</head>
<body>
@if (round is null)
{
    <main class="page">
        <header class="hero">
            <div class="brand"><span class="brand-name">@WebTexts.Brand</span></div>
            <h1 class="title">@WebTexts.LinkInvalidTitle</h1>
            <p class="when">@WebTexts.LinkInvalid</p>
        </header>
    </main>
}
else
{
    <main id="round-page" class="page"
          data-code="@(firebase is null ? null : Model.Code)"
          data-firebase-api-key="@firebase?.ApiKey"
          data-firebase-auth-domain="@firebase?.AuthDomain"
          data-firebase-project-id="@firebase?.ProjectId"
          data-firebase-app-id="@firebase?.AppId"
          data-nickname-max="@RoundModel.NicknameMaxLength">
        <header class="hero">
            <div class="brand">
                <svg class="logo" aria-hidden="true" viewBox="0 0 26 18"><rect x="0" y="0" width="7" height="7" rx="1.5" fill="#F6F1E7"/><rect x="9.5" y="0" width="7" height="7" rx="1.5" fill="#F6F1E7"/><rect x="19" y="0" width="7" height="7" rx="1.5" fill="#F6F1E7"/><rect x="0" y="10" width="7" height="7" rx="1.5" fill="#F6F1E7"/><rect x="9.5" y="10" width="7" height="7" rx="1.5" fill="#F6F1E7"/><rect x="19" y="10" width="7" height="7" rx="1.5" fill="#FFC83D"/></svg>
                <span class="brand-name">@WebTexts.Brand</span>
                <span class="brand-tag">@WebTexts.BrandTag</span>
            </div>
            <h1 class="title">@round.GroupName</h1>
            <p class="when">@round.When</p>
            <p class="format">@round.Format</p>
            <div class="counts">
                <div class="count">@round.GoingCount@if (round.Capacity is { } capacity)
                    {<span class="count-of">/@capacity</span>}</div>
                <div>
                    <div class="count-label">@WebTexts.Confirmed</div>
                    @if (round.Hint is { } hint)
                    {
                        <div class="count-hint">@hint</div>
                    }
                </div>
                <div class="court" aria-hidden="true">
                    @foreach (var taken in round.Court)
                    {
                        <span class="@(taken ? "taken" : "open")"></span>
                    }
                </div>
            </div>
        </header>
        <div class="net" aria-hidden="true"></div>
        <section class="lists">
            @if (round.ClosedMessage is { } closed)
            {
                <p class="closed">@closed</p>
            }
            @foreach (var list in round.Lists)
            {
                <div class="list-head">
                    <h2>@list.Title</h2>
                    <span class="list-count">@list.Count</span>
                </div>
                <ol class="list">
                    @foreach (var line in list.Lines)
                    {
                        <li>
                            <span class="place">@line.Place</span>
                            @if (line.IsVacant)
                            {
                                <span class="vacant">@WebTexts.Vacant</span>
                            }
                            else
                            {
                                <span class="name">@line.Name</span>
                            }
                        </li>
                    }
                </ol>
            }
            @if (round.Notice is { } notice)
            {
                <p class="notice">@notice</p>
            }
        </section>
        <footer class="actions">
            <p id="page-status" class="status" role="status" aria-live="polite" hidden></p>
            @if (firebase is not null)
            {
                <div class="answers">
                    <button type="button" id="answer-going" class="answer answer-going" disabled>@WebTexts.Going</button>
                    <button type="button" id="answer-not-going" class="answer answer-not-going" disabled>@WebTexts.NotGoing</button>
                </div>
                <noscript><p class="notice">@WebTexts.NoScript</p></noscript>
            }
            <button type="button" id="sign-out" class="link" hidden>@WebTexts.SignOut</button>
        </footer>
        <div id="sheet" class="sheet-backdrop" hidden>
            <section class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
                <button type="button" id="sheet-close" class="sheet-close" aria-label="@WebTexts.Close">×</button>
                <p class="sheet-context">@round.When</p>
                <h2 id="sheet-title">@WebTexts.SheetTitle</h2>
                <div id="sheet-choice" class="sheet-group">
                    <p>@WebTexts.SheetBody</p>
                    <p id="embedded-warning" class="message" hidden>@WebTexts.Embedded</p>
                    <button type="button" id="sign-in-google" class="primary"><span class="google-mark" aria-hidden="true">@WebTexts.GoogleMark</span>@WebTexts.Google</button>
                    <button type="button" id="sign-in-email" class="link">@WebTexts.Email</button>
                </div>
                <form id="sheet-email" class="sheet-group" novalidate hidden>
                    <div id="email-tabs" class="tabs">
                        <button type="button" id="email-sign-in">@WebTexts.SignInTab</button>
                        <button type="button" id="email-sign-up">@WebTexts.SignUpTab</button>
                    </div>
                    <label class="field">@WebTexts.EmailLabel
                        <input id="email" type="email" autocomplete="email" inputmode="email" required>
                    </label>
                    <label id="password-field" class="field">@WebTexts.PasswordLabel
                        <input id="password" type="password" autocomplete="current-password" minlength="6" aria-describedby="password-rule">
                        <span id="password-rule" class="list-note">@WebTexts.PasswordRule</span>
                    </label>
                    <button type="submit" id="email-submit" class="secondary">@WebTexts.SignInTab</button>
                    <button type="button" id="email-forgot" class="link">@WebTexts.Forgot</button>
                    <button type="button" id="email-back" class="link">@WebTexts.Back</button>
                </form>
                <form id="sheet-nickname" class="sheet-group" novalidate hidden>
                    <label class="field">@WebTexts.NicknameLabel
                        <input id="nickname" type="text" autocomplete="nickname" maxlength="@RoundModel.NicknameMaxLength" required>
                    </label>
                    <button type="submit" id="nickname-submit" class="primary">@WebTexts.NicknameSubmit</button>
                </form>
                <p id="sheet-message" class="message" role="alert" hidden></p>
                <p>@WebTexts.Privacy</p>
                <p class="legal">@WebTexts.LegalBefore@if (Model.TermsUrl is { } terms)
                    {<a href="@terms" rel="noopener noreferrer" target="_blank">@WebTexts.Terms</a>}
                    else
                    {@WebTexts.Terms}@WebTexts.LegalBetween@if (Model.PrivacyUrl is { } privacy)
                    {<a href="@privacy" rel="noopener noreferrer" target="_blank">@WebTexts.PrivacyPolicy</a>}
                    else
                    {@WebTexts.PrivacyPolicy}@WebTexts.LegalAfter</p>
            </section>
        </div>
    </main>
}
</body>
</html>
