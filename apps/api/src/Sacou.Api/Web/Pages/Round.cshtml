@page "/r/{code}"
@model RoundModel
@{
    Layout = null;
    var round = Model.Round;
    var firebase = round is { IsOpen: true } ? Model.Firebase : null;
}
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="strict-origin">
    <title>@(round?.GroupName ?? WebTexts.LinkInvalidTitle)</title>
    @await Html.PartialAsync("Shared/_OpenGraph", Model)
    @if (Model.Assets is { } assets)
    {
        @foreach (var style in assets.Styles)
        {
            <link rel="stylesheet" href="@style">
        }
        <script type="module" src="@assets.Script"></script>
    }
</head>
<body>
@if (round is null)
{
    <main class="page">
        <header class="hero">
            <div class="brand"><span class="brand-name">@WebTexts.Brand</span></div>
            <h1 class="title">@WebTexts.LinkInvalidTitle</h1>
            <p class="when">@WebTexts.LinkInvalid</p>
        </header>
    </main>
}
else
{
    <main id="round-page" class="page"
          data-code="@(firebase is null ? null : Model.Code)"
          data-firebase-api-key="@firebase?.ApiKey"
          data-firebase-auth-domain="@firebase?.AuthDomain"
          data-firebase-project-id="@firebase?.ProjectId"
          data-firebase-app-id="@firebase?.AppId"
          data-nickname-max="@RoundModel.NicknameMaxLength"
          data-drop-in-phrase="@round.DropInPhrase"
          data-has-regulars="@(round.HasRegulars ? "true" : "false")">
        <header class="hero">
            <div class="brand">
                <svg class="logo" aria-hidden="true" viewBox="0 0 26 18"><rect x="0" y="0" width="7" height="7" rx="1.5" fill="#F6F1E7"/><rect x="9.5" y="0" width="7" height="7" rx="1.5" fill="#F6F1E7"/><rect x="19" y="0" width="7" height="7" rx="1.5" fill="#F6F1E7"/><rect x="0" y="10" width="7" height="7" rx="1.5" fill="#F6F1E7"/><rect x="9.5" y="10" width="7" height="7" rx="1.5" fill="#F6F1E7"/><rect x="19" y="10" width="7" height="7" rx="1.5" fill="#FFC83D"/></svg>
                <span class="brand-name">@WebTexts.Brand</span>
                <span class="brand-tag">@WebTexts.BrandTag</span>
            </div>
            <h1 class="title">@round.GroupName</h1>
            <p class="when">@round.When</p>
            <p class="format">@round.Format</p>
            <div class="counts">
                <div class="count">@round.GoingCount@if (round.Capacity is { } capacity)
                    {<span class="count-of">/@capacity</span>}</div>
                <div>
                    <div class="count-label">@WebTexts.Confirmed</div>
                    @if (round.Hint is { } hint)
                    {
                        <div class="count-hint">@hint</div>
                    }
                    @if (round.DropInWindow is { } window)
                    {
                        <div class="count-hint" id="drop-in-window">@window</div>
                    }
                </div>
                <div class="court" aria-hidden="true">
                    @foreach (var taken in round.Court)
                    {
                        <span class="@(taken ? "taken" : "open")"></span>
                    }
                </div>
            </div>
        </header>
        <div class="net" aria-hidden="true"></div>
        <section class="lists">
            @if (round.ClosedMessage is { } closed)
            {
                <p class="closed">@closed</p>
            }
            @foreach (var list in round.Lists)
            {
                <div class="list-head">
                    <h2>@list.Title</h2>
                    <span class="list-count">@list.Count</span>
                </div>
                <ol class="list">
                    @foreach (var line in list.Lines)
                    {
                        <li>
                            <span class="place">@line.Place</span>
                            @if (line.IsVacant)
                            {
                                <span class="vacant">@WebTexts.Vacant</span>
                            }
                            else
                            {
                                <span class="name">@line.Name</span>
                            }
                        </li>
                    }
                </ol>
            }
            @if (round.Notice is { } notice)
            {
                <p class="notice">@notice</p>
            }
        </section>
        <footer class="actions">
            <p id="page-status" class="status" role="status" aria-live="polite" hidden></p>
            @if (firebase is not null)
            {
                <div class="answers">
                    <button type="button" id="answer-going" class="answer answer-going" disabled>@WebTexts.Going</button>
                    <button type="button" id="answer-not-going" class="answer answer-not-going" disabled>@WebTexts.NotGoing</button>
                </div>
                <div id="leave-confirm" class="leave" role="group" aria-labelledby="leave-title" hidden>
                    <h2 id="leave-title" class="leave-title">@WebTexts.LeaveTitle</h2>
                    <p class="leave-body">@WebTexts.LeaveBody</p>
                    <div class="answers">
                        <button type="button" id="leave-yes" class="answer answer-not-going">@WebTexts.LeaveConfirm</button>
                        <button type="button" id="leave-keep" class="answer answer-going">@WebTexts.LeaveKeep</button>
                    </div>
                </div>
                <noscript><p class="notice">@WebTexts.NoScript</p></noscript>
            }
            <button type="button" id="sign-out" class="link" hidden>@WebTexts.SignOut</button>
        </footer>
        @await Html.PartialAsync("Shared/_SignInSheet", Model.SignInSheet)
    </main>
}
</body>
</html>
