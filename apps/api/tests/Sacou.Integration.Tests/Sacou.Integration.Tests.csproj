<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <!-- The budget of the court stream (ADR 0081): SACOU_PERF_GATE=1 in the environment of a Release build turns it on. -->
    <PropertyGroup Condition="'$(SACOU_PERF_GATE)' == '1' And '$(Configuration)' == 'Release'">
        <DefineConstants>$(DefineConstants);SACOU_PERF_GATE</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="Npgsql" />
        <!-- Testcontainers itself is pinned too: its version carries the Ryuk digest. -->
        <PackageReference Include="Testcontainers" />
        <PackageReference Include="Testcontainers.PostgreSql" />
        <PackageReference Include="xunit.v3.mtp-v2" />
    </ItemGroup>
    <ItemGroup>
        <!-- The real API over the real database: sign-in end to end (E3.1). -->
        <ProjectReference Include="../../src/Sacou.Api/Sacou.Api.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../TestSupport/*.cs" LinkBase="TestSupport" />
    </ItemGroup>
</Project>
