{
  "name": "@sacou/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit && expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@sacou/match-engine": "workspace:*",
    "@sacou/volley-rules": "workspace:*",
    "expo": "~58.0.21",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-sqlite": "58.0.14",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "~19.3.0",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
