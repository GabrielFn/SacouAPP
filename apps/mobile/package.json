{
  "name": "@sacou/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit && expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --dir src",
    "eas-build-post-install": "pnpm --dir ../.. --filter @sacou/volley-rules --filter @sacou/match-engine run build"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "27.1.1",
    "@react-native-firebase/auth": "27.1.1",
    "@react-native-google-signin/google-signin": "17.0.0",
    "@sacou/match-engine": "workspace:*",
    "@sacou/volley-rules": "workspace:*",
    "@tanstack/query-async-storage-persister": "5.107.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-persist-client": "5.107.1",
    "expo": "~58.0.21",
    "expo-battery": "~58.0.4",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-haptics": "58.0.7",
    "expo-keep-awake": "58.0.3",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "58.0.21",
    "expo-sqlite": "58.0.14",
    "expo-status-bar": "58.0.4",
    "openapi-fetch": "0.17.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "~19.3.0",
    "eslint": "catalog:",
    "openapi-typescript": "7.13.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
