{
  "minTokens": 50,
  "minLines": 1,
  "format": ["typescript", "tsx", "csharp"],
  "path": [
    "packages/match-engine/src",
    "packages/volley-rules/src",
    "apps/mobile/src",
    "apps/api/src"
  ],
  "ignore": [
    "**/*.test.*",
    "**/*.test.fixture.ts",
    "**/*.data.ts",
    "**/golden/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**"
  ],
  "ignorePattern": ["using [A-Za-z0-9_.= ]+;"]
}
