<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!-- The OpenAPI contract (ADR 0042). Same patch as the rest of ASP.NET. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="[10.0.14]" />
    <!-- Direct and exact: the model the transformers use, the version the 10.0.14 asks for, so audit:api always sees it. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="[2.12.2]" />
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="[10.0.14]" />
        <!-- Design-time only (migrations), never shipped: PrivateAssets="all" on the reference. -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.14]" />
        <!-- Direct, so the runtime gets the same EF Core patch the Design package compiles against. -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="[10.0.14]" />
        <!-- ID token validation (ADR 0036). Older 8.x releases had CVEs: stay on the latest. -->
        <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="[8.23.0]" />
        <PackageVersion Include="Npgsql" Version="10.0.3" />
        <!-- Aligned with Npgsql 10.0.3 (ADR 0037). -->
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="[10.0.3]" />
        <!-- Errors of the API to Sentry (ADR 0080). Exact: the scrubber depends on the event shape of this version. -->
        <PackageVersion Include="Sentry.AspNetCore" Version="[7.0.1]" />
        <!-- Exact: the package version sets the pinned Ryuk digest (docs/arquitetura/adr/0020-postgres-local-e-testes-de-integracao.md). -->
        <PackageVersion Include="Testcontainers" Version="[4.16.0]" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="[4.16.0]" />
        <!-- Exact: below 0.13.5, dependencies inside async methods vanish in optimized builds. -->
        <PackageVersion Include="TngTech.ArchUnitNET" Version="[0.13.5]" />
        <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
    </ItemGroup>
</Project>
