<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
        <!-- Exact: below 0.13.5, dependencies inside async methods vanish in optimized builds. -->
        <PackageVersion Include="TngTech.ArchUnitNET" Version="[0.13.5]" />
        <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
    </ItemGroup>
</Project>
